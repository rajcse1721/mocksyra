# Configure these in Render's Environment page. Do not commit real secret values.
FRONTEND_ORIGIN=https://your-site.netlify.app
APP_URL=https://your-site.netlify.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_SECRET_KEY=sb_secret_set_only_in_render

# Optional hosted video. When empty, local/direct WebRTC remains available.
DAILY_API_KEY=

# Optional match-email delivery
RESEND_API_KEY=
EMAIL_FROM=Mocksyra <alerts@your-domain.com>
